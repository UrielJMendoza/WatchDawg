# ── Site ────────────────────────────────────────────────────────────────
# Canonical origin for SEO (sitemap, canonical URLs, Open Graph).
# On Vercel this falls back to the production URL automatically.
NEXT_PUBLIC_SITE_URL=https://watchdawg.example.com

# ── Optional live sources ───────────────────────────────────────────────
# USGS, NASA EONET, GDACS, GDELT, newsroom RSS and city police data need no keys.

# ACLED conflict data (free research account at https://acleddata.com/register/).
# Either username + password (OAuth) or a pre-issued access token.
ACLED_USERNAME=
ACLED_PASSWORD=
# ACLED_ACCESS_TOKEN=

# Socrata app token — raises rate limits for the city police open-data portals.
# https://dev.socrata.com/docs/app-tokens.html
SOCRATA_APP_TOKEN=

# ── Legacy auth (optional; the public globe needs none of this) ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=
